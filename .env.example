# Optional configuration for QuakeScope
# Unauthenticated requests are limited to 60 requests/hr per IP by GitHub.
# Provide a GitHub Personal Access Token to increase the rate limit to 5,000 requests/hr.
GITHUB_TOKEN=

# USGS Earthquake Feed Selection (options: 4.5_week, 2.5_week, all_week, 4.5_month)
USGS_FEED=4.5_week

# Output target directory (default: current directory or _site)
OUTPUT_DIR=.

# Optional Google Maps JavaScript API key for interactive Google Maps provider
# If omitted, QuakeScope uses Leaflet with OpenStreetMap / CartoDB dark tiles with zero configuration.
GOOGLE_MAPS_API_KEY=

